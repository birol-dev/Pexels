// Cloudflare Workers config for the marketing site (static assets only, no Worker script).
{
  "$schema": "https://unpkg.com/wrangler@4/config-schema.json",
  "name": "stockfinder-ai",
  "compatibility_date": "2026-06-01",
  "assets": {
    "directory": "./website",
    // /about -> /about/ and serves about/index.html, matching the site's canonical URLs
    "html_handling": "auto-trailing-slash",
    // serves website/404.html with a 404 status for unknown paths
    "not_found_handling": "404-page"
  },
  // keep the workers.dev URL alive alongside the custom domain
  "workers_dev": true,
  "routes": [{ "pattern": "stockfinderai.birol.tech", "custom_domain": true }]
}
