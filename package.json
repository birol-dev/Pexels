{
  "name": "stockfinder-ai",
  "version": "1.3.2",
  "description": "An Electron desktop app for finding and downloading Pexels stock assets with AI.",
  "type": "module",
  "main": "./out/main/index.js",
  "author": "eact6",
  "license": "MIT",
  "homepage": "https://stockfinderai.birol.tech",
  "repository": {
    "type": "git",
    "url": "https://github.com/birol-dev/Pexels.git"
  },
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck": "tsc -b --noEmit",
    "check:contrast": "node scripts/check-contrast.mjs",
    "test": "node --experimental-strip-types --import ./test/support/register.mjs --test test/**/*.test.ts",
    "start": "install-electron && electron-vite dev",
    "dev": "install-electron && electron-vite dev",
    "preview": "install-electron && electron-vite preview",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "npm run build && electron-builder --mac",
    "build:linux": "npm run build && electron-builder --linux AppImage deb",
    "site:dev": "npx wrangler dev",
    "site:deploy": "node website/validate-seo.js && npx wrangler deploy"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@paper-design/shaders": "^0.0.81",
    "@phosphor-icons/react": "^2.1.10",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "^44.7.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "postcss": "^8.5.15",
    "prettier": "^3.7.4",
    "radix-ui": "^1.7.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.6",
    "zustand": "^5.0.13"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
